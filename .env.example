# Copy this file to `.env` (gitignored) and adjust for your machine:
#   cp .env.example .env
# Real environment variables override values in .env.
# Everything is optional: with no .env the app just uses local SQLite.

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use the default local SQLite file in the app data
# folder (on Windows: %APPDATA%\com.caaarrrlll.notetaker\notes.db).
#
# To connect to an existing server database instead, set one of:
#   PostgreSQL:     postgres://USER:PASSWORD@HOST:5432/DATABASE
#   MySQL/MariaDB:  mysql://USER:PASSWORD@HOST:3306/DATABASE
#   SQLite (custom file location): sqlite://C:/path/to/notes.db?mode=rwc
#
# The database must already exist; the app creates its tables on startup.
# DATABASE_URL=

# Maximum connections in the pool (server databases). Default: SeaORM's default.
# DATABASE_MAX_CONNECTIONS=10

# --- Tests ------------------------------------------------------------------
# `cargo make test` uses in-memory SQLite. To also test against a server DB,
# point this at a THROWAWAY database (tests leave rows behind):
# TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/note_taker_test
