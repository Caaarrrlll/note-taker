{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Note Taker",
  "version": "0.1.0",
  "identifier": "com.caaarrrlll.notetaker",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Note Taker",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Block-based note taking",
    "longDescription": "A block-based note-taking app with nested pages. Stores notes in a local SQLite file, or connects to a PostgreSQL or MySQL/MariaDB server.",
    "publisher": "Caaarrrlll",
    "homepage": "https://github.com/Caaarrrlll/note-taker",
    "linux": {
      "deb": {
        "section": "editors"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE"
  }
}
