{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--manifest-path", "./src-tauri/Cargo.toml"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo",
      "args": ["check", "--manifest-path", "./src-tauri/Cargo.toml"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "tauri dev",
      "type": "shell",
      "command": "cargo",
      "args": ["tauri", "dev"],
      "problemMatcher": ["$rustc"]
    }
  ]
}
